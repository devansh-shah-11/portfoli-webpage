---
import ThemeToggle from "./ThemeToggle.astro"
import data from "../../data.json"

const navItems = [
  { title: "Projects", id: "projects" },
  { title: "Experience", id: "experience" },
  { title: "Skills", id: "skills" },
  { title: "Education", id: "education" },
  { title: "About", id: "about" },
  { title: "Contact", id: "contact" },
]
---

<header class="sticky top-0 z-20 border-b border-line bg-paper/85 backdrop-blur">
  <div class="px-5 sm:px-8">
  <div class="mx-auto max-w-5xl h-14 flex items-center justify-between gap-4">
    <a href="/" class="font-serif text-lg font-medium shrink-0">{data.personal.name}</a>
    <nav aria-label="Primary" class="flex items-center gap-1 sm:gap-2 text-sm">
      <ul class="hidden md:flex items-center gap-1">
        {
          navItems.map((item) => (
            <li>
              <a
                data-nav={item.id}
                href={`/#${item.id}`}
                class="px-2.5 py-1.5 rounded-md text-muted hover:text-ink transition-colors aria-[current=true]:text-accent"
              >
                {item.title}
              </a>
            </li>
          ))
        }
      </ul>
      <ThemeToggle />
    </nav>
  </div>
  </div>
  <!-- Compact nav for small screens -->
  <nav aria-label="Sections" class="md:hidden border-t border-line/60">
    <ul class="mx-auto max-w-5xl px-4 flex gap-1 overflow-x-auto text-sm">
      {
        navItems.map((item) => (
          <li class="shrink-0">
            <a data-nav={item.id} href={`/#${item.id}`} class="block px-2.5 py-2 text-muted aria-[current=true]:text-accent">
              {item.title}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  // Highlight the nav link for the section currently in view
  document.addEventListener("astro:page-load", () => {
    const links = document.querySelectorAll<HTMLAnchorElement>("[data-nav]")
    const sections = document.querySelectorAll<HTMLElement>("main section[id]")
    if (!sections.length) return
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return
          links.forEach((l) =>
            l.setAttribute("aria-current", String(l.dataset.nav === e.target.id))
          )
        })
      },
      { rootMargin: "-40% 0px -55% 0px" }
    )
    sections.forEach((s) => io.observe(s))
  })
</script>
