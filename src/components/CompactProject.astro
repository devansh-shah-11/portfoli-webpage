---
import { type Project } from "../utils/data"
interface Props { project: Project }
const { project } = Astro.props
---

<article class="grid gap-3 border-b border-line py-5 first:pt-0 last:border-b-0 sm:grid-cols-[minmax(0,1fr)_minmax(12rem,0.65fr)] sm:gap-8">
  <div>
    <div class="flex flex-wrap items-center gap-2">
      <h3 class="text-lg font-medium leading-snug">{project.title}</h3>
    </div>
    <p class="mt-2 text-[0.95rem] leading-relaxed text-muted">{project.summary}</p>
    {project.built?.[0] && <p class="mt-2 text-[0.95rem] leading-relaxed">{project.built[0]}</p>}
  </div>
  <div class="sm:pl-3">
    {project.stat && (
      <p class="text-[0.95rem] leading-relaxed">
        <span class="font-serif text-xl font-medium text-accent">{project.stat.value}</span>
        <span class="ml-2 text-muted">{project.stat.label}</span>
      </p>
    )}
    <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Technologies and methods">
      {project.tech.map((tech) => <li class="rounded-md bg-tint px-2 py-0.5 font-mono text-xs text-ink/80">{tech}</li>)}
    </ul>
  </div>
</article>
