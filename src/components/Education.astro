---
import { portfolioData } from "../utils/data"
const { education } = portfolioData
---

<div class="grid gap-5 md:grid-cols-2">
  {education.map((e) => (
    <article class="rounded-2xl border border-line p-5 sm:p-6">
      <p class="font-mono text-[0.8125rem] text-muted">{e.date}</p>
      <h3 class="mt-2 text-xl font-medium leading-snug">{e.degree}</h3>
      <p class="mt-1 text-[0.95rem] text-muted">{e.institution}</p>
      {e.coursework && e.coursework.length > 0 && (
        <div class="mt-5 border-t border-line pt-4">
          <h4 class="font-mono text-xs uppercase tracking-wider text-accent">Selected coursework</h4>
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {e.coursework.map((course) => <li class="rounded-md bg-tint px-2.5 py-1 text-[0.95rem]">{course}</li>)}
          </ul>
        </div>
      )}
    </article>
  ))}
</div>
