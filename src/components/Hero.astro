---
import GitHubIcon from "./icons/GitHub.astro"
import LinkedInIcon from "./icons/LinkedIn.astro"
import MailIcon from "./icons/Mail.astro"
import { portfolioData, formatText } from "../utils/data"

const { personal, socialLinks, stats } = portfolioData
const iconMap: Record<string, any> = { GitHub: GitHubIcon, LinkedIn: LinkedInIcon, Mail: MailIcon }
---

<section id="top" class="pt-14 sm:pt-24 pb-16 sm:pb-20 mx-auto max-w-5xl">
  <div class="flex items-center gap-3 mb-8">
    <img
      src={personal.image}
      alt={personal.imageAlt}
      width="48"
      height="48"
      class="size-12 rounded-full object-cover ring-1 ring-line"
    />
    <p class="font-mono text-xs sm:text-sm text-muted">{personal.affiliation}</p>
  </div>

  <h1
    class="font-serif text-[2.4rem] leading-[1.1] sm:text-6xl sm:leading-[1.06] font-medium max-w-3xl"
    set:html={formatText(personal.headline)}
  />
  <p class="mt-6 text-lg sm:text-xl text-muted max-w-2xl">{personal.subheadline}</p>

  <ul class="mt-6 flex flex-wrap gap-x-2 gap-y-1 font-mono text-xs text-muted" aria-label="Focus areas">
    {
      personal.focus.map((f, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && <span aria-hidden="true" class="text-accent">/</span>}
          {f}
        </li>
      ))
    }
  </ul>

  <div class="mt-9 flex flex-wrap items-center gap-3">
    <a
      href="#work"
      class="inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-paper hover:opacity-90 transition-opacity"
    >
      View projects <span aria-hidden="true">↓</span>
    </a>
    {
      personal.resume && (
        <a
          href={personal.resume}
          download
          class="inline-flex items-center gap-2 rounded-full border border-line px-5 py-2.5 text-sm font-medium hover:border-accent hover:text-accent transition-colors"
        >
          Resume (PDF)
        </a>
      )
    }
    <ul class="flex items-center gap-1 sm:ml-2">
      {
        socialLinks.map((s) => {
          const Icon = iconMap[s.icon]
          return (
            <li>
              <a
                href={s.url}
                target={s.url.startsWith("http") ? "_blank" : undefined}
                rel="noopener noreferrer"
                aria-label={s.name}
                title={s.name}
                class="grid place-items-center size-10 rounded-full text-muted hover:text-accent hover:bg-tint transition-colors"
              >
                <Icon class="size-5" />
              </a>
            </li>
          )
        })
      }
    </ul>
  </div>

  <ul class="mt-16 sm:mt-20 grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-8 border-t border-line pt-8" aria-label="Highlights">
    {
      stats.map((s) => (
        <li>
          <p class="font-serif text-3xl sm:text-4xl font-medium text-accent leading-none">{s.value}</p>
          <p class="mt-2 text-sm text-muted leading-snug max-w-[15rem]">{s.label}</p>
        </li>
      ))
    }
  </ul>
</section>
