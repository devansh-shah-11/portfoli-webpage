---
import { projectLinks, type Project } from "../utils/data"

interface Props {
  project: Project
  large?: boolean
}
const { project, large = false } = Astro.props
const links = projectLinks(project)
---

<article
  class="group relative flex flex-col md:[&:last-child:nth-child(odd)]:col-span-2 rounded-xl border border-line p-6 sm:p-7 transition-colors hover:border-accent/70 hover:bg-tint/50"
>
  <p class="font-mono text-xs uppercase tracking-wider text-accent">{project.kind}</p>

  <h3 class={`mt-3 font-medium leading-snug ${large ? "text-2xl sm:text-3xl" : "text-xl sm:text-2xl"}`}>
    <a href={`/projects/${project.slug}`} class="after:absolute after:inset-0 after:rounded-xl focus-visible:after:outline focus-visible:after:outline-2 focus-visible:after:outline-accent">
      {project.title}
    </a>
  </h3>
  <p class="mt-3 text-muted">{project.summary}</p>

  <div class="mt-auto pt-6">
  <div class="flex items-baseline gap-3 border-t border-line pt-5">
    <span class="font-serif text-2xl font-medium text-accent whitespace-nowrap">{project.stat.value}</span>
    <span class="text-sm text-muted leading-snug">{project.stat.label}</span>
  </div>

  <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Technologies">
    {
      project.tech.map((t) => (
        <li class="rounded-md bg-tint px-2 py-0.5 font-mono text-[0.7rem] text-ink/80">{t}</li>
      ))
    }
  </ul>

  <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-medium">
    <span class="text-accent transition-transform group-hover:translate-x-0.5">
      Case study <span aria-hidden="true">→</span>
    </span>
    {
      links.map((l) => (
        <a
          href={l.url}
          target="_blank"
          rel="noopener noreferrer"
          class="relative z-10 text-muted hover:text-accent underline-offset-4 hover:underline"
        >
          {l.label} <span aria-hidden="true">↗</span>
        </a>
      ))
    }
  </div>
  </div>
</article>
