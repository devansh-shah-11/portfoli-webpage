---
import SunIcon from "./icons/Sun.astro"
import MoonIcon from "./icons/Moon.astro"
import SystemIcon from "./icons/System.astro"

const THEMES = ["Light", "Dark", "System"]
---

<div class="relative" transition:persist>
  <button
    id="theme-toggle-btn"
    type="button"
    aria-haspopup="true"
    aria-expanded="false"
    class="relative grid place-items-center size-9 rounded-md text-muted hover:text-ink transition-colors"
  >
    <span class="sr-only">Choose theme</span>
    <SunIcon id="light" class="theme-toggle-icon absolute size-5 transition-transform" />
    <MoonIcon id="dark" class="theme-toggle-icon absolute size-5 transition-transform" />
    <SystemIcon id="system" class="theme-toggle-icon absolute size-5 transition-transform" />
  </button>
  <ul
    id="themes-menu"
    role="menu"
    class="hidden absolute right-0 top-11 min-w-[8rem] p-1 text-sm rounded-lg border border-line bg-paper shadow-lg"
  >
    {
      THEMES.map((theme) => (
        <li role="none">
          <button
            type="button"
            role="menuitem"
            data-theme={theme.toLowerCase()}
            class="themes-menu-option w-full text-left px-3 py-1.5 rounded-md hover:bg-tint"
          >
            {theme}
          </button>
        </li>
      ))
    }
  </ul>
</div>

<script is:inline>
  ;(function () {
    var mq = window.matchMedia("(prefers-color-scheme: dark)")
    var btn = document.getElementById("theme-toggle-btn")
    var menu = document.getElementById("themes-menu")

    function pref() {
      try { return localStorage.getItem("theme") || "light" } catch (e) { return "light" }
    }
    function apply() {
      var p = pref()
      var dark = p === "dark" || (p === "system" && mq.matches)
      document.documentElement.classList.toggle("dark", dark)
      document.querySelectorAll(".theme-toggle-icon").forEach(function (el) {
        el.style.transform = el.id === p ? "scale(1)" : "scale(0)"
      })
    }
    function close() {
      menu.classList.add("hidden")
      btn.setAttribute("aria-expanded", "false")
    }

    apply()
    mq.addEventListener("change", apply)

    btn.addEventListener("click", function (e) {
      e.stopPropagation()
      var open = menu.classList.toggle("hidden") === false
      btn.setAttribute("aria-expanded", String(open))
    })
    document.addEventListener("click", close)
    document.addEventListener("keydown", function (e) { if (e.key === "Escape") close() })
    menu.querySelectorAll(".themes-menu-option").forEach(function (el) {
      el.addEventListener("click", function () {
        try { localStorage.setItem("theme", el.dataset.theme) } catch (e) {}
        apply()
        close()
      })
    })
    document.addEventListener("astro:after-swap", apply)
  })()
</script>
