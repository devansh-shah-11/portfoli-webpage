---
import { portfolioData } from "../utils/data"
const { experiences } = portfolioData
---

<ol class="relative">
  {
    experiences.map((e) => (
      <li class="relative grid gap-3 md:grid-cols-[13rem_1fr] md:gap-10 pb-12 last:pb-0 pl-6 md:pl-0">
        <span
          aria-hidden="true"
          class="absolute left-0 top-2 bottom-0 w-px bg-line md:left-[13rem] md:ml-[1.25rem] md:-translate-x-1/2"
        />
        <span
          aria-hidden="true"
          class="absolute left-0 top-[0.55rem] size-2 -translate-x-[3.5px] rounded-full bg-accent md:left-[13rem] md:ml-[1.25rem] md:-translate-x-1/2"
        />
        <div>
          <p class="font-mono text-xs text-muted">{e.date}</p>
          <h3 class="mt-1 text-lg font-medium leading-snug">{e.company}</h3>
          <p class="text-sm text-accent">{e.title}</p>
        </div>
        <ul class="space-y-3 text-muted md:pl-6">
          {e.bullets.map((b) => (
            <li class="relative pl-4 before:absolute before:left-0 before:top-[0.7em] before:h-px before:w-2 before:bg-accent/70">
              {b}
            </li>
          ))}
        </ul>
      </li>
    ))
  }
</ol>
