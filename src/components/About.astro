---
import { portfolioData } from "../utils/data"
const { personal, about } = portfolioData
---

<div class="grid items-start gap-8 md:grid-cols-[minmax(0,1fr)_15rem] md:gap-12">
  <div class="max-w-3xl space-y-4 text-base leading-relaxed text-muted sm:text-lg">
    {about.map((paragraph) => <p>{paragraph}</p>)}
  </div>
  <img
    src={personal.aboutImage}
    alt={personal.aboutImageAlt}
    width="356"
    height="450"
    loading="lazy"
    class="order-first w-36 rounded-xl object-cover aspect-[4/5] ring-1 ring-line md:order-none md:w-full"
  />
</div>
