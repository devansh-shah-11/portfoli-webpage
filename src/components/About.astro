---
import { portfolioData } from "../utils/data"
const { personal, about } = portfolioData
---

<div class="grid items-start gap-8 md:grid-cols-[minmax(0,1fr)_18rem] md:gap-12">
  <div class="max-w-3xl space-y-5 text-lg leading-relaxed text-muted sm:text-xl">
    {about.map((paragraph, i) => <p class={i === 0 ? "font-serif text-2xl text-ink sm:text-3xl" : ""}>{paragraph}</p>)}
  </div>
  <img
    src={personal.aboutImage}
    alt={personal.aboutImageAlt}
    width="356"
    height="450"
    loading="lazy"
    class="order-first w-44 rounded-xl object-cover aspect-[4/5] ring-1 ring-line md:order-none md:w-full"
  />
</div>
