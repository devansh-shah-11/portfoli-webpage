---
import Layout from "@/layouts/Layout.astro"
import Hero from "@/components/Hero.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import TitleSection from "@/components/TitleSection.astro"
import ProjectCard from "@/components/ProjectCard.astro"
import CompactProject from "@/components/CompactProject.astro"
import Experience from "@/components/Experience.astro"
import Skills from "@/components/Skills.astro"
import Education from "@/components/Education.astro"
import Contact from "@/components/Contact.astro"
import { portfolioData } from "../utils/data"

const featured = portfolioData.projects.filter((p) => p.featured)
const moreProjects = portfolioData.projects.filter((p) => !p.featured)
---

<Layout
  title="Devansh Shah | AI/ML Engineer"
  description="MS Computer Science at NYU Courant. Building production AI systems, multimodal retrieval, computer vision pipelines, LLM reasoning research, and GPU performance models."
>
  <Hero />

  <div class="space-y-20 sm:space-y-28">
    <SectionContainer id="projects">
      <TitleSection num="01" title="Projects" />
      <p class="mb-8 max-w-3xl text-muted">Selected work across production AI, retrieval systems, computer vision, and GPU performance. Technical approaches and results are shown inline.</p>
      <div class="grid items-stretch gap-5 xl:grid-cols-2">
        {featured.map((project) => <ProjectCard project={project} />)}
      </div>

      {moreProjects.length > 0 && (
        <div class="mt-14">
          <div class="mb-5 flex items-baseline justify-between gap-4 border-b border-line pb-3">
            <h3 class="text-2xl font-medium">More projects</h3>
            <span class="font-mono text-[0.68rem] uppercase tracking-wider text-muted">{moreProjects.length} projects</span>
          </div>
          <div>
            {moreProjects.map((project) => <CompactProject project={project} />)}
          </div>
        </div>
      )}
    </SectionContainer>

    <SectionContainer id="experience">
      <TitleSection num="02" title="Experience" />
      <p class="mb-8 max-w-3xl text-muted">Professional work combining implementation details, evaluation results, and the problems each system was designed to solve.</p>
      <Experience />
    </SectionContainer>

    <SectionContainer id="skills">
      <TitleSection num="03" title="Technical skills" />
      <Skills />
    </SectionContainer>

    <SectionContainer id="education">
      <TitleSection num="04" title="Education" />
      <Education />
    </SectionContainer>

    <SectionContainer id="contact">
      <TitleSection num="05" title="Contact" />
      <Contact />
    </SectionContainer>
  </div>
</Layout>
